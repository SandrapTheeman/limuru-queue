# Limuru Cottage Hospital Queue Management System - Environment Variables
# Copy this file to .env and fill in your values

# ===========================================
# Application
# ===========================================
NODE_ENV=development
API_URL=http://localhost:8787
WEB_URL=http://localhost:3000

# ===========================================
# Cloudflare Workers
# ===========================================
# Cloudflare Account ID (found in Cloudflare Dashboard)
CLOUDFLARE_ACCOUNT_ID=

# Cloudflare API Token (create at dash.cloudflare.com/profile/api-tokens)
# Required permissions: Account Workers Scripts, Account D1, Account KV Namespaces, Account R2
CLOUDFLARE_API_TOKEN=

# ===========================================
# Cloudflare Resources (created via wrangler)
# ===========================================
# D1 Database name (limuru-queue-db)
DATABASE_NAME=limuru-queue-db

# KV Namespace names
KV_SESSION=limuru-queue-kv
KV_CACHE=limuru-queue-kv

# R2 Bucket name (limuru-queue-storage)
R2_ASSETS=limuru-queue-storage
R2_BACKUP=limuru-queue-storage

# ===========================================
# Authentication
# ===========================================
# JWT Secret (generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Default password for new users (change immediately after first login)
DEFAULT_PASSWORD=ChangeMe123!

# ===========================================
# Twilio (for SMS and WhatsApp)
# ===========================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER=
WHATSAPP_VERIFY_TOKEN=limuru_whatsapp_verify_2026

# ===========================================
# SendGrid (for Email Notifications)
# ===========================================
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@limuruhospital.co.ke

# ===========================================
# AI Services (Optional)
# ===========================================
OLLAMA_ENDPOINT=http://localhost:11434
CLOUDFLARE_ACCOUNT_ID=34b813955eef738aa87154f6a89f2cff
OPENAI_API_KEY=
AI_PROVIDER=cloudflare

# ===========================================
# HMS Adapter (Hospital Management System)
# ===========================================
HMS_ADAPTER_TYPE=mock
OPENMRS_BASE_URL=
OPENMRS_USERNAME=
OPENMRS_PASSWORD=
BAHMNI_BASE_URL=
BAHMNI_USERNAME=
BAHMNI_PASSWORD=
OPENELIS_BASE_URL=
OPENELIS_API_KEY=

# ===========================================
# Monitoring
# ===========================================
SENTRY_DSN=
