# Use a pre-built approach - copy only what's needed
FROM node:20-alpine AS base
WORKDIR /app

# Copy only essential files for a minimal run
# This assumes node_modules is pre-built or mounted
COPY . .

# If we have node_modules, use it
RUN if [ -d "node_modules" ]; then \
      echo "Using existing node_modules"; \
    else \
      echo "No node_modules found - using minimal deps"; \
    fi

EXPOSE 3000

CMD ["node", "-e", "console.log('Web server placeholder - needs full build')"]
