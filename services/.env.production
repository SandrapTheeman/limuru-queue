# Hospital Queue System - Production Environment Variables
# Copy this file to .env and fill in your values

# ============================================
# Database
# ============================================
DB_PASSWORD=your-secure-database-password-here

# ============================================
# JWT
# ============================================
JWT_SECRET=your-very-secure-jwt-secret-key-min-32-chars

# ============================================
# CORS
# ============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=https://limuruhospital.co.ke,https://www.limuruhospital.co.ke

# ============================================
# Twilio (SMS, WhatsApp, Voice)
# Get from https://console.twilio.com
# ============================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=+1234567890

# ============================================
# OpenRouter (Cloud LLM)
# Get from https://openrouter.ai
# ============================================
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Ollama (Local LLM) - Optional
# ==========================================
OLLAMA_ENDPOINT=http://ollama:11434
