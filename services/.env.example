# Hospital Queue System - Environment Variables

# ============================================
# Application Environment
# ============================================
NODE_ENV=production

# ============================================
# Database
# ============================================
POSTGRES_USER=hospital_queue
POSTGRES_PASSWORD=hospital_queue_secure_password
POSTGRES_DB=hospital_queue
DATABASE_URL=postgresql://hospital_queue:hospital_queue_secure_password@database:5432/hospital_queue

# ============================================
# API Configuration
# ============================================
PORT=8787
JWT_SECRET=hospital-queue-jwt-secret-change-in-production
DEFAULT_PASSWORD=password123

# ============================================
# Web Application
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_WS_URL=ws://localhost:8787
